{
  "manifest_version": 3,
  "name": "Site Language & Timezone Switch",
  "version": "1.0.0",
  "description": "只对指定网站生效：把网页的时区（Date/Intl）和语言（navigator/Accept-Language）切换成你配置的值。",
  "homepage_url": "https://github.com/acd407/language-timezone-switch",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "permissions": [
    "storage",
    "scripting",
    "webNavigation",
    "declarativeNetRequestWithHostAccess",
    "activeTab"
  ],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "worker.js",
    "scripts": ["common.js", "worker.js"]
  },

  "action": {
    "default_title": "Language & Timezone Switch",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "lang-tz-switch@acd407.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
